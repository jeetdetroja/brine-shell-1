# Copy this file to .env and fill in real values.
# NEVER commit .env — it's already in .gitignore.

# --- Server ---
# Hostinger's Node.js App Manager sets PORT itself; this is only used
# when running locally on your own machine.
PORT=3000
# Set to "production" on Hostinger so session cookies require HTTPS.
# Leave unset (or "development") for local testing over plain http.
NODE_ENV=production

# --- CORS ---
# The exact origin allowed to call this API from the browser (can't be
# "*" now that cookies/credentials are involved).
ALLOWED_ORIGIN=https://www.brineandshell.com
# Only needed if the API ends up on a different subdomain than the
# site (e.g. api.brineandshell.com serving www.brineandshell.com) —
# set to ".brineandshell.com" (with the leading dot) so the session
# cookie is shared across both. Leave blank for same-domain setups.
COOKIE_DOMAIN=

# --- Sessions & admin ---
# Any long random string — used to sign customer + admin session
# cookies. Generate one with: openssl rand -hex 32
SESSION_SECRET=
# The password for the /admin.html order-status page. Pick something
# strong; it's the only thing protecting that page.
ADMIN_PASSWORD=

# --- Google Sign-In ---
# From Google Cloud Console -> APIs & Services -> Credentials -> the
# OAuth 2.0 Client ID you create for "Sign in with Google" (see
# README.md for the exact steps). This is safe to expose in frontend
# code — it's a public identifier, not a secret.
GOOGLE_CLIENT_ID=

# --- Resend (email) ---
# Get this from resend.com after verifying the brineandshell.com domain.
RESEND_API_KEY=
CONTACT_FROM_EMAIL=orders@brineandshell.com
CONTACT_TO_EMAIL=hello@brineandshell.com

# --- Google Sheets (orders / contact / newsletter storage) ---
# From the Google Cloud service account JSON key file.
GOOGLE_SERVICE_ACCOUNT_EMAIL=
# Paste the private key with literal \n for line breaks (keep the quotes).
GOOGLE_PRIVATE_KEY=""
# The long ID in your Google Sheet's URL between /d/ and /edit.
GOOGLE_SHEET_ID=

# --- Razorpay ---
# From dashboard.razorpay.com -> Settings -> API Keys.
# Use the rzp_test_ keys until you're ready to go live.
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=

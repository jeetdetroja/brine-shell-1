# Copy this file to .env and fill in real values.
# NEVER commit .env — it's already in .gitignore.

# --- Server ---
# Hostinger's Node.js App Manager sets PORT itself; this is only used
# when running locally on your own machine.
PORT=3000

# --- CORS ---
# The domain(s) allowed to call this API from the browser.
ALLOWED_ORIGIN=https://www.brineandshell.com

# --- Resend (email) ---
# Get this from resend.com after verifying the brineandshell.com domain.
RESEND_API_KEY=
CONTACT_FROM_EMAIL=orders@brineandshell.com
CONTACT_TO_EMAIL=hello@brineandshell.com

# --- Google Sheets (orders / contact / newsletter storage) ---
# From the Google Cloud service account JSON key file.
GOOGLE_SERVICE_ACCOUNT_EMAIL=
# Paste the private key with literal \n for line breaks (keep the quotes).
GOOGLE_PRIVATE_KEY=""
# The long ID in your Google Sheet's URL between /d/ and /edit.
GOOGLE_SHEET_ID=

# --- Razorpay ---
# From dashboard.razorpay.com -> Settings -> API Keys.
# Use the rzp_test_ keys until you're ready to go live.
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
